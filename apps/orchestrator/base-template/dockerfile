FROM oven/bun:1

# Set the working directory inside the container to /home/user/app
WORKDIR /home/user/app

# Copy the package files first for layer caching
COPY package.json bun.lock* ./

# Install dependencies into node_modules
RUN bun install

# Copy template files
COPY . .

# Expose port 5173 for Vite dev server
EXPOSE 5173

# Run Vite dev server in a persistent supervisor loop
CMD ["sh", "-c", "while true; do bun run dev || sleep 1; done"]
