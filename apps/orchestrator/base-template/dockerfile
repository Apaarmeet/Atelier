     FROM oven/bun:1

    # Set the working directory inside the container
    WORKDIR /app

    # Copy the package files first (good Docker caching practice)
    COPY package.json bun.lock* ./

    # INSTALL THE DEPENDENCIES FOR LINUX
    RUN bun install

    # Copy the rest of your empty React base template into the container
    COPY . .

    # Expose port 5173 so the iframe can access the Vite dev server
    EXPOSE 5173

    # Keep the container running infinitely so the Pod doesn't crash
    CMD ["sleep", "infinity"]
